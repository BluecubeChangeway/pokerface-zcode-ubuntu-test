{
  "name": "performance-card-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_DATA_BACKEND=local vite",
    "server": "node local-server/server.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"**/*.dom.test.ts\" --exclude \"**/*.stories.ts\" --exclude \"**/*.stories.tsx\"",
    "test:all": "vitest run",
    "test:ui": "vitest --ui --exclude \"**/*.dom.test.ts\" --exclude \"**/*.stories.ts\" --exclude \"**/*.stories.tsx\"",
    "verify": "tsc -b && vitest run && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:visual:report": "playwright show-report playwright-report",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write .",
    "theme:audit": "tsx scripts/audit-theme-tokens.ts",
    "i18n:extract": "tsx scripts/extract-i18n-keys.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.8.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.9",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.8.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-docs": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "happy-dom": "^20.14.5",
    "http-server": "^14.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "storybook": "^8.6.19",
    "storybook-dark-mode": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
